{
  "about": "a - b. Prints the low 8 bits, then 1 if it borrowed (so the answer is - 256).",
  "inputs": [
    "a",
    "b"
  ],
  "code": [
    "LDA a",
    "SUB b",
    "OUT",
    "JC done",
    "LDI 1",
    "OUT",
    "done: HLT"
  ],
  "data": {
    "a": 7,
    "b": 6
  },
  "result": {
    "second_output_adds": -256
  },
  "tests": [
    {
      "with": {
        "a": 7,
        "b": 6
      },
      "expect": 1
    },
    {
      "with": {
        "a": 15,
        "b": 17
      },
      "expect": -2
    },
    {
      "with": {
        "a": 1,
        "b": 255
      },
      "expect": -254
    },
    {
      "with": {
        "a": 255,
        "b": 255
      },
      "expect": 0
    }
  ]
}
