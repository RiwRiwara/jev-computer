{
  "about": "Greatest common divisor of a and b (Euclid, by repeated subtraction). a and b must be 1-255.",
  "inputs": [
    "a",
    "b"
  ],
  "code": [
    "loop: LDA a",
    "SUB b",
    "JZ done",
    "JC a_bigger",
    "LDA b",
    "SUB a",
    "STA b",
    "JMP loop",
    "a_bigger: STA a",
    "JMP loop",
    "done: LDA a",
    "OUT",
    "HLT"
  ],
  "data": {
    "a": 48,
    "b": 18
  },
  "result": {},
  "tests": [
    {
      "with": {
        "a": 48,
        "b": 18
      },
      "expect": 6
    },
    {
      "with": {
        "a": 17,
        "b": 5
      },
      "expect": 1
    },
    {
      "with": {
        "a": 100,
        "b": 75
      },
      "expect": 25
    },
    {
      "with": {
        "a": 12,
        "b": 12
      },
      "expect": 12
    },
    {
      "with": {
        "a": 255,
        "b": 85
      },
      "expect": 85
    }
  ]
}
