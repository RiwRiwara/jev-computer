{
  "about": "n! = 1 x 2 x ... x n, multiplying by repeated addition (a loop inside a loop). Answers overflow above 255 (n > 5).",
  "inputs": [
    "n"
  ],
  "code": [
    "loop: LDA n",
    "JZ done",
    "STA k",
    "LDI 0",
    "STA t",
    "inner: LDA t",
    "ADD r",
    "JC over",
    "STA t",
    "LDA k",
    "SUB one",
    "STA k",
    "JZ next",
    "JMP inner",
    "next: LDA t",
    "STA r",
    "LDA n",
    "SUB one",
    "STA n",
    "JMP loop",
    "done: LDA r",
    "OUT",
    "over: HLT"
  ],
  "data": {
    "n": 5,
    "r": 1,
    "k": 0,
    "t": 0,
    "one": 1
  },
  "result": {
    "no_output": "overflow (> 255)"
  },
  "tests": [
    {
      "with": {
        "n": 0
      },
      "expect": 1
    },
    {
      "with": {
        "n": 1
      },
      "expect": 1
    },
    {
      "with": {
        "n": 3
      },
      "expect": 6
    },
    {
      "with": {
        "n": 5
      },
      "expect": 120
    },
    {
      "with": {
        "n": 6
      },
      "expect": "overflow (> 255)"
    }
  ]
}
