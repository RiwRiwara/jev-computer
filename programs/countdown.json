{
  "about": "Count down from n to 0.",
  "inputs": [
    "n"
  ],
  "code": [
    "LDA n",
    "loop: OUT",
    "JZ done",
    "SUB one",
    "JMP loop",
    "done: HLT"
  ],
  "data": {
    "n": 5,
    "one": 1
  },
  "tests": [
    {
      "with": {
        "n": 5
      },
      "expect": [
        5,
        4,
        3,
        2,
        1,
        0
      ]
    },
    {
      "with": {
        "n": 0
      },
      "expect": [
        0
      ]
    }
  ]
}
