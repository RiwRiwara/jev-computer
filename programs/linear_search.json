{
  "about": "Position (0-7) of x in a list of 8 numbers, or 'not found'. Walks the list by rewriting its own LDA instruction.",
  "inputs": [
    "list",
    "x"
  ],
  "code": [
    "loop: LDA i",
    "SUB n",
    "JZ not_found",
    "get: LDA list",
    "SUB x",
    "JZ found",
    "LDA get+1",
    "ADD one",
    "STA get+1",
    "LDA i",
    "ADD one",
    "STA i",
    "JMP loop",
    "found: LDA i",
    "OUT",
    "not_found: HLT"
  ],
  "data": {
    "list": [
      4,
      7,
      9,
      15,
      23,
      42,
      99,
      200
    ],
    "x": 42,
    "i": 0,
    "n": 8,
    "one": 1
  },
  "result": {
    "no_output": "not found"
  },
  "tests": [
    {
      "with": {
        "list": [
          4,
          7,
          9,
          15,
          23,
          42,
          99,
          200
        ],
        "x": 4
      },
      "expect": 0
    },
    {
      "with": {
        "list": [
          4,
          7,
          9,
          15,
          23,
          42,
          99,
          200
        ],
        "x": 42
      },
      "expect": 5
    },
    {
      "with": {
        "list": [
          4,
          7,
          9,
          15,
          23,
          42,
          99,
          200
        ],
        "x": 200
      },
      "expect": 7
    },
    {
      "with": {
        "list": [
          4,
          7,
          9,
          15,
          23,
          42,
          99,
          200
        ],
        "x": 5
      },
      "expect": "not found"
    }
  ]
}
