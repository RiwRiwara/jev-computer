{
  "about": "a / b by repeated subtraction: the whole-number quotient. b must not be 0 (the loop never ends).",
  "inputs": [
    "a",
    "b"
  ],
  "code": [
    "loop: LDA a",
    "SUB b",
    "JC more",
    "LDA q",
    "OUT",
    "HLT",
    "more: STA a",
    "LDA q",
    "ADD one",
    "STA q",
    "JMP loop"
  ],
  "data": {
    "a": 200,
    "b": 7,
    "q": 0,
    "one": 1
  },
  "result": {},
  "tests": [
    {
      "with": {
        "a": 200,
        "b": 7
      },
      "expect": 28
    },
    {
      "with": {
        "a": 255,
        "b": 16
      },
      "expect": 15
    },
    {
      "with": {
        "a": 100,
        "b": 200
      },
      "expect": 0
    },
    {
      "with": {
        "a": 255,
        "b": 255
      },
      "expect": 1
    }
  ]
}
