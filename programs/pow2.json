{
  "about": "2 to the power y, by doubling y times. Answers overflow above 255 (y > 7).",
  "inputs": [
    "y"
  ],
  "code": [
    "loop: LDA y",
    "JZ done",
    "SUB one",
    "STA y",
    "LDA r",
    "ADD r",
    "JC over",
    "STA r",
    "JMP loop",
    "done: LDA r",
    "OUT",
    "over: HLT"
  ],
  "data": {
    "y": 5,
    "r": 1,
    "one": 1
  },
  "result": {
    "no_output": "overflow (> 255)"
  },
  "tests": [
    {
      "with": {
        "y": 0
      },
      "expect": 1
    },
    {
      "with": {
        "y": 1
      },
      "expect": 2
    },
    {
      "with": {
        "y": 5
      },
      "expect": 32
    },
    {
      "with": {
        "y": 7
      },
      "expect": 128
    },
    {
      "with": {
        "y": 8
      },
      "expect": "overflow (> 255)"
    }
  ]
}
